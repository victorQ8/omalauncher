<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press on the app icon, then the installed coding agents (TerminalActivity adds those).
     The icon itself brings back the last terminal. Actions: ui/Sessions.kt (TerminalActions). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="new"
        android:shortcutShortLabel="@string/shortcut_new">
        <intent
            android:action="dev.omalauncher.terminal.NEW"
            android:targetClass="dev.omalauncher.TerminalActivity"
            android:targetPackage="dev.omalauncher.terminal" />
    </shortcut>
    <shortcut
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="dev.omalauncher.terminal.SETTINGS"
            android:targetClass="dev.omalauncher.TerminalActivity"
            android:targetPackage="dev.omalauncher.terminal" />
    </shortcut>
</shortcuts>
