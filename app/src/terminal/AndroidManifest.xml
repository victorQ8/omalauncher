<?xml version="1.0" encoding="utf-8"?>
<!-- The terminal app: the launcher's terminal on its own. Its windows are the launcher's (LinuxWindowActivity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Sets Linux up on first run, then opens a terminal and steps aside; only in Recents while it waits.
             Its actions are in ui/Sessions.kt (TerminalActions). -->
        <activity
            android:name=".TerminalActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Omalauncher.Window">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Files and text shared from other apps land in ~/Downloads, and a terminal opens there. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
